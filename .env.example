# Razorpay API keys (Dashboard -> Settings -> API Keys). Server-side only; the Key ID is sent to the
# browser at checkout by /api/razorpay/create-order, so no NEXT_PUBLIC_ variable is needed.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Razorpay webhook secret (Dashboard -> Settings -> Webhooks), separate from the API secret above
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Supabase secret key (Supabase Dashboard -> Project Settings -> API Keys -> Secret keys, starts with sb_secret_).
# Server-side only. Without it the shop still works, but orders, milk registrations and the
# first-order discount are not saved. The project URL and publishable key are public and set in
# src/lib/supabase/config.ts.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Order emails (customer invoice + "new order" alert). Use the same SMTP account as Supabase Auth,
# e.g. Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_USER=resend, SMTP_PASSWORD=<API key re_...>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_xxxxxxxxxxxx
# Optional: sender shown to customers (defaults to Mithai Wallah <support@mithaiwallah.shop>)
MAIL_FROM=Mithai Wallah <support@mithaiwallah.shop>
# Optional: who gets "new order" alerts, comma-separated (defaults to support@mithaiwallah.shop)
ORDER_NOTIFY_EMAIL=anuradhaenterprises371@gmail.com
